# =========================================================================
# 快递驿站智汇系统 · Nginx 站点配置样例（TASK.md D04 配套）
# ---------------------------------------------------------------------------
# 使用位置：宝塔面板 → 网站 → hrm-admin 站点 → 设置 → 配置文件，
#           用本文件 server{...} 内容整体替换（保留面板自动生成的
#           listen/server_name 中与本机一致的部分亦可，以面板实际为准）。
# 手工方式：也可放入 /www/server/panel/vhost/nginx/hrm-admin.conf 后
#           nginx -t && systemctl reload nginx（宝塔环境路径）。
#
# 关键设计（勿删改，均有业务依赖）：
#   1. location / 的 try_files 回退 index.html：前端 vue-router 使用
#      history 模式，刷新/直连子路由（如 /employee）必须回退到入口页，
#      否则刷新即 404；
#   2. location /api/ 反代 127.0.0.1:8080：后端只在回环地址监听，
#      8080 不对公网开放（安全组只放行 22/80/443）；
#   3. proxy_set_header X-Real-IP / X-Forwarded-For：登录日志 login_log.login_ip
#      取 X-Forwarded-For 首个 IP，缺失会导致记录成 127.0.0.1（TASK D04 验收项）；
#   4. client_max_body_size 12m：与后端 spring.servlet.multipart.max-request-size=12MB
#      对齐（Excel 导入限制单文件 10MB）。
# =========================================================================

server {
    listen 80;
    listen [::]:80;
    server_name change_me_domain_or_server_ip;      # 换成你的域名或服务器公网 IP

    # 前端站点根目录（deploy.sh 同步 dist 的目标目录）
    root /www/wwwroot/hrm-admin;
    index index.html;

    access_log /www/wwwlogs/hrm_admin.log;
    error_log  /www/wwwlogs/hrm_admin.error.log;

    # 上传限制：与后端 multipart 12MB 对齐（Excel 导入 ≤10MB）
    client_max_body_size 12m;

    # ---------- gzip 压缩（静态资源/JSON 传输体积） ----------
    gzip on;
    gzip_min_length 1k;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml;
    gzip_vary on;

    # ---------- 带内容哈希的静态资源：长缓存 ----------
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA 入口页不缓存：发版后浏览器立即取到新 index.html
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # ---------- API 反向代理 ----------
    location /api/ {
        proxy_pass http://127.0.0.1:8080;    # proxy_pass 不带 URI，原样透传 /api/v1/... 路径
        proxy_http_version 1.1;

        # 透传真实客户端信息（登录日志 IP 依赖，勿删）
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 10s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;

        # Excel 导出走流式响应，关闭代理缓冲让浏览器即时开始下载
        proxy_buffering off;
    }

    # ---------- SPA history 模式回退（必须保留） ----------
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ---------- 可选：HTTPS（域名 + 证书就绪后启用） ----------
    # 1) 宝塔面板 → 网站 → SSL → Let's Encrypt 申请后，将 listen 80 块替换为：
    # listen 443 ssl http2;
    # listen [::]:443 ssl http2;
    # server_name change_me_domain;
    # ssl_certificate     /www/server/panel/vhost/cert/change_me_domain/fullchain.pem;
    # ssl_certificate_key /www/server/panel/vhost/cert/change_me_domain/privkey.pem;
    # ssl_protocols TLSv1.2 TLSv1.3;
    # ssl_ciphers HIGH:!aNULL:!MD5;
    # 2) 并新增 80 端口跳转块：
    # server {
    #     listen 80;
    #     server_name change_me_domain;
    #     return 301 https://$host$request_uri;
    # }
}
