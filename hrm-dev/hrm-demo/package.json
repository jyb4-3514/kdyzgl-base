{
  "name": "hrm-demo",
  "version": "1.0.0",
  "private": true,
  "description": "快递驿站智汇系统 · 三端演示 Demo（纯前端 + Mock 假数据，零后端依赖）",
  "type": "module",
  "scripts": {
    "dev": "vite --mode demo",
    "build": "vite build --mode demo",
    "build:prod": "vite build --mode production",
    "preview": "vite preview --mode demo",
    "serve:dist": "node scripts/serve.mjs",
    "verify:mock": "node scripts/verify-mock.mjs",
    "verify:mobile": "node scripts/verify-mobile-t13-t16.mjs",
    "verify:tokens": "node scripts/gen-element-tokens.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:style": "stylelint \"src/**/*.{scss,vue}\"",
    "lint:style:fix": "stylelint \"src/**/*.{scss,vue}\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test --config e2e/playwright.config.js",
    "e2e:report": "playwright show-report e2e/playwright-report",
    "prepare": "husky"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.9",
    "element-plus": "^2.9.3",
    "pinia": "^2.3.0",
    "vant": "^4.10.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@pinia/testing": "^0.1.7",
    "@playwright/test": "^1.63.0",
    "@vant/touch-emulator": "^1.5.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "sass": "^1.83.0",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vconsole": "^3.15.1",
    "vite": "^6.0.5",
    "vitest": "^5.0.1"
  }
}
