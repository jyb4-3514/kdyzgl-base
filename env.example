# =====================================================================
# 快递驿站智汇系统 · 后端配置模板（Spring Boot）
# ---------------------------------------------------------------------
# 使用说明：
#   1. 复制本文件在【服务器本地】重命名为 application-prod.yml（或对应环境）；
#   2. 将下面所有占位符替换为真实值，真实值只保存在服务器磁盘，绝不提交 Git；
#   3. 本文件本身（env.example）可提交，用于给开发人员参考配置项。
#
#   本模板只写参数名与占位符，不包含任何真实密码。
# =====================================================================

server:
  port: 8080
  servlet:
    context-path: /

spring:
  profiles:
    active: prod

  # ---------- 数据源（MySQL 默认；PostgreSQL 见注释的备选块） ----------
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://127.0.0.1:3306/kdyzgl?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false
    username: change_me_db_user
    password: change_me_db_password

  # 备选：PostgreSQL
  # datasource:
  #   driver-class-name: org.postgresql.Driver
  #   url: jdbc:postgresql://127.0.0.1:5432/kdyzgl
  #   username: change_me_db_user
  #   password: change_me_db_password

  # ---------- Flyway 数据库迁移 ----------
  flyway:
    enabled: true
    locations: classpath:db/migration

  # ---------- Redis ----------
  data:
    redis:
      host: 127.0.0.1
      port: 6379
      password: change_me_redis_password
      database: 0

# ---------- JWT / 登录态 ----------
jwt:
  # 秘钥长度需满足签名算法要求，务必使用随机生成的强密钥替换
  secret: change_me_jwt_secret_please_generate_a_long_random_string
  # 单位：秒，示例为 24 小时
  expire: 86400
  header: Authorization

# ---------- 文件存储（本地 / 对象存储二选一） ----------
file:
  storage-type: local            # local | oss
  local-path: /data/kdyzgl/upload
  # oss:
  #   endpoint: change_me_oss_endpoint
  #   access-key-id: change_me_access_key_id
  #   access-key-secret: change_me_access_key_secret
  #   bucket: change_me_bucket
  #   domain: change_me_oss_domain

# ---------- 邮件 ----------
mail:
  host: smtp.example.com
  port: 465
  username: change_me_mail_user
  password: change_me_mail_password

# ---------- AI / LLM（如启用助手与知识库模块，按需填写） ----------
llm:
  base-url: change_me_llm_base_url
  api-key: change_me_llm_api_key
  model: change_me_model_name

# ---------- 日志 ----------
logging:
  level:
    root: info
    com.qiujie: info